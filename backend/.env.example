# AI Interviewer Configuration

# Replace with your actual Gemini API Key (obtained from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key

# Replace with your actual Groq API Key (obtained from Groq Console)
GROQ_API_KEY=your_groq_api_key

# Port for FastAPI server (default: 8000)
PORT=8000

# Database connection URL
# PostgreSQL (Prisma Postgres / Supabase / Neon / Local Postgres):
# DATABASE_URL=postgresql://username:password@host:5432/dbname
# SQLite (Local Dev fallback):
# DATABASE_URL=sqlite:///interview_db.db
DATABASE_URL=your_prisma_postgres_connection_string

# Optional AI model overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-1.5-flash
